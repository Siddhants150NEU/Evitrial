# --- documentation kept local, never pushed to the remote ---
# per-script sidecar docs
src/*.md
tests/*.md
# top-level project docs (README.md stays tracked; everything else is local-only)
HANDOFF.md
CLAUDE.md
CONTRACTS.md
0?_*.md

# --- ALL of data/ is ignored EXCEPT the one small tracked doc ---
# (this auto-ignores any future dataset cache, index, or adapter under data/)
data/*
!data/annotations/
data/annotations/*
!data/annotations/LABEL_MAPPING.md

# --- run outputs (regenerable, never commit) ---
reports/runs/
# figures are derived from runs/ — shipping them without their source runs is
# incoherent, and it's 3.9 MB of PNG/SVG that the notebook rebuilds on demand
reports/figures/

# --- local analysis notebooks ---
# 1.5 MB of embedded output images + execution counts; regenerable from runs/.
# Delete this line if you want the notebook published (clear outputs first:
# pip install nbstripout && nbstripout --install)
notebooks/

# --- generated presentation exports (rebuilt from the generator, not source) ---
EVI_TRIAL_deck.pptx
EVI_TRIAL_deck.pdf

# --- Python / build artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- model weights (large; regenerable) ---
*.pt
*.bin
*.safetensors
*.onnx

# --- secrets / local env ---
.env
.env.*
*.local

# --- logs ---
*.log

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.webapp.pid
.webapp.log

# --- agent / editor local state ---
# (already covered by the global ~/.config/git/ignore on this machine; repeated
# here so a fresh clone on another machine doesn't leak it)
.claude/settings.local.json
